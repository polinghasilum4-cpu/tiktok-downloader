# Isi di Vercel Project Settings -> Environment Variables PROJECT FRONTEND ini
# (project yang nge-host index.html di xs0cietylabsz.biz.id)
# JANGAN commit file .env asli ke git.

# Harus SAMA PERSIS dengan salah satu value API_KEYS di 3 project backend
# (api-instagram-main, api-spotify-main, api.soundcloud-main).
# Value ini CUMA ada di sini (server), gak pernah dikirim ke browser.
BACKEND_API_KEY=isi-sama-dengan-salah-satu-API_KEYS-di-backend

# URL hasil deploy masing-masing project backend
INSTAGRAM_API_BASE=https://api-instagram-main.vercel.app
SPOTIFY_API_BASE=https://api-spotify-main.vercel.app
SOUNDCLOUD_API_BASE=https://api-soundcloud-main.vercel.app

# Opsional, default sudah https://xs0cietylabsz.biz.id kalau dikosongkan
SELF_ORIGIN=https://xs0cietylabsz.biz.id
